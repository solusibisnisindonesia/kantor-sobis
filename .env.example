# Kantor Sobis 1.1 — konfigurasi opsional lokal.
# Kunci diisi sendiri oleh pemilik lewat Setelan aplikasi.
# Menyimpan kunci tidak menyalakan Live; pilih Live dan konfirmasi di UI.
# Jangan membagikan file .env asli atau database/cadangan privat.
#
# Untuk memaksa semua panggilan menjadi simulasi tanpa biaya:
# LLM_MODE=mock
# Nilai live/auto di lingkungan TIDAK mengaktifkan mode berbayar.
#
# Port dan binding launcher (opsional):
# PORT=8765
# HOST=127.0.0.1
# Binding LAN 0.0.0.0 memerlukan jaringan tepercaya; belum ada login.
# Tidak ada pengunduhan daftar model, font, atau aset otomatis.
